                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/httpapi.taskListResponse"
                        }
                    },
                    "400": {
                        "description": "invalid request",
                        "schema": {
                            "type": "object",
                            "properties": {
                                "error": {
                                    "type": "string"
                                }
                            }
