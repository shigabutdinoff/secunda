                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Исполнитель",
                        "name": "assignee_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Размер страницы, 1–100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Смещение, нельзя вместе с cursor",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "next_cursor из предыдущей страницы",
                        "name": "cursor",
                        "in": "query"
                    }
                ],
